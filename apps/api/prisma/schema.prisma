// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model CheckIn {
  id              String   @id @default(uuid())
  date            String   // "2024-01-15"
  time            String   // "07:05"
  session         String   // "morning" | "evening"

  // Sức khỏe
  feeling         String   // "good" | "okay" | "bad"
  voiceTranscript String   @default("")
  symptoms        String   @default("[]") // JSON string array
  medicationTaken Boolean  @default(false)
  medicationNotes String   @default("")

  // Cách nhập
  inputType       String   // "button" | "voice" | "text"

  createdAt       DateTime @default(now())

  @@map("check_ins")
}

// ───────────────────────────────────────────────
// Bảng lưu cảnh báo
// ───────────────────────────────────────────────
model Alert {
  id         String    @id @default(uuid())
  type       String    // AlertType
  severity   String    // "low" | "medium" | "high" | "emergency"

  title      String
  message    String
  action     String

  isRead     Boolean   @default(false)
  isResolved Boolean   @default(false)

  createdAt  DateTime  @default(now())
  readAt     DateTime?

  @@map("alerts")
}

// ───────────────────────────────────────────────
// Bảng lưu thông báo đã gửi
// ───────────────────────────────────────────────
model Notification {
  id          String    @id @default(uuid())
  type        String    // "email" | "web"
  subject     String
  body        String
  alertId     String?
  isDelivered Boolean   @default(false)
  toEmail     String?
  sentAt      DateTime  @default(now())
  deliveredAt DateTime?

  @@map("notifications")
}